      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=patch -R -p0 \u003c /usr/share/maliit/plugins/com/jolla/custom_headless/KeyboardBase.patch",
