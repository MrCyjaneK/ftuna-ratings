  "name": "xplanet-background",
  "rpm_version": "1.3.1",
  "release": "14",
  "arch": "aarch64",
  "issues": [
    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 1 ] ; then; /usr/bin/resxplanet.bash; systemctl-user enable xplanet.service",
      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 0 ] ; then; systemctl-user --no-reload disable xplanet.service; systemctl-user stop xplanet.service",
      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%postun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl-user daemon-reload; if [ $1 -ge 1 ] ; then; systemctl-user try-restart xplanet.service",
      "color": "red"
    },
    {
      "module": "systemd",
      "path": "/usr/lib/systemd/user/xplanet.service",
      "code": "systemd.service",
      "detail": "scope=user user=session group=defaultuser exec=/usr/bin/xplanet $XPLANET_OPTIONS -prev_command ${XPLANET_PREV} -post_command ${XPLANET_POST} sandbox=none",
      "color": "green"
    },
    {
      "module": "systemd",
      "path": "/usr/lib/systemd/user/xplanet.timer",
      "code": "systemd.timer",
      "detail": "scope=user activates=xplanet.service",
      "color": "green"
    }
  ]
