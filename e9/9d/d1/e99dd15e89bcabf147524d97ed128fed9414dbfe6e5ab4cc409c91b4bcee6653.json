      "path": "%pre",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -gt 1 ] ; then; rm -f /etc/resolv.conf; \\; ln -s /var/run/connman/resolv.conf /etc/resolv.conf"
