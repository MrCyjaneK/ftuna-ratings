    },
    {
      "module": "scriptlet",
      "path": "%posttrans",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=umask 113; setsid --fork sh -c '(/var/lib/dnscrypt-proxy/dnscrypt-proxy-install-service.sh \"$1\" \"$2\")' sh_call_inst-dnscrypt-proxy-service \"$$\" \"/var/log/dnscry"
