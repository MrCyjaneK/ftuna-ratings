{
  "version": 7,
  "sha256": "b35d71cf63e9069a7fe9a5c544ab572a1ed3d0092b65afff8c32bdffa4f10715",
  "key": "mirror/openrepos/eatdirt/personal/main/x/xplanet-background-1.3.1-1.armv7hl.rpm",
  "name": "xplanet-background",
  "rpm_version": "1.3.1",
  "release": "1",
  "arch": "armv7hl",
  "issues": [
    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 1 ] ; then; systemctl-user enable xplanet.service; systemctl-user start xplanet.service",
      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 0 ] ; then; systemctl-user --no-reload disable xplanet.service; systemctl-user stop xplanet.service",
      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%postun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl-user daemon-reload; if [ $1 -ge 1 ] ; then; systemctl-user try-restart xplanet.service",
      "color": "red"
    },
    {
      "module": "systemd",
      "path": "/usr/lib/systemd/user/xplanet.service",
      "code": "systemd.service",
      "detail": "scope=user user=session group=nemo exec=/usr/bin/xplanet $XPLANET_OPTIONS -prev_command ${XPLANET_PREV} -post_command ${XPLANET_POST} sandbox=none",
      "color": "green"
    }
  ]
}
