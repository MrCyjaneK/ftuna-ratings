      "path": "%triggerun ssh-server",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ \"$1\" != 0 -a -r /var/run/sshd.pid ] ; then; touch /var/run/sshd.restart; fi"
    },
