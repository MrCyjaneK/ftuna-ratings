      "module": "scriptlet",
      "path": "%triggerun openssh-server",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=gawk\t'BEGIN {IGNORECASE=1}; /^hostkey/ || /^hostdsakey/ {sawhostkey = sawhostkey + 1}; END {exit sawhostkey}' /etc/ssh/sshd_config"
    },
