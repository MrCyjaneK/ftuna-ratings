  "issues": [
    {
      "module": "scriptlet",
      "path": "%pre",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=rm -f /etc/resolv.conf; \\; ln -s /var/run/connman/resolv.conf /etc/resolv.conf"
    },
    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ ! -f /usr/lib/systemd/system/dnsmasq.service ]; then; cp /var/lib/dnsmasq/dnsmasq.service /usr/lib/systemd/system/dnsmasq.service; fi"
    },
    {
      "module": "systemd",
      "path": "/etc/systemd/system/connman.service.d/override.conf",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=unknown sandbox=none"
    },
    {
      "module": "systemd",
      "path": "/etc/systemd/system/dnscrypt-proxy.service.d/override.conf",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=/usr/bin/dnscrypt-proxy \"-config\" \"/var/lib/harbour-dns-alternative/dnscrypt-proxy.toml\" sandbox=none"
    },
    {
      "module": "systemd",
      "path": "/etc/systemd/system/dnsmasq.service.d/override.conf",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=/usr/sbin/dnsmasq --enable-dbus=org.DNS.Alternative.dnsmasq -k sandbox=none"
    }
  ]
