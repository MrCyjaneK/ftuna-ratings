      "module": "sailjail",
      "path": "/usr/share/applications/harbour-blocky.desktop",
      "code": "sailjail.disabled",
      "detail": "Sandboxing=Disabled"
    },
    {
      "module": "scriptlet",
      "path": "%pre",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if ! getent passwd blocky \u003e/dev/null ; then; useradd -r -s /sbin/nologin blocky; fi"
    },
    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl daemon-reload; if [ $1 -eq 1 ]; then; systemctl enable blocky.service"
    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 0 ]; then; systemctl stop blocky.service; systemctl disable blocky.service"
    },
    {
      "module": "scriptlet",
      "path": "%postun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 0 ]; then; systemctl daemon-reload; rm /etc/resolv.conf"
    },
    {
      "module": "setuid",
      "path": "/usr/bin/harbour-blocky",
      "code": "setuid",
      "detail": "/usr/bin/harbour-blocky mode 0104755 user root group root file"
    },
    {
      "module": "systemd",
      "path": "/etc/systemd/system/connman.service.d/override.conf",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=/usr/sbin/connmand -n -W nl80211 --nobacktrace --noplugin=wifi --nodnsproxy $SYSCONF_ARGS $CONNMAN_ARGS sandbox=none"
    },
    {
      "module": "systemd",
      "path": "/usr/lib/systemd/system/blocky.service",
      "code": "systemd.service",
      "detail": "scope=system user=blocky group=root exec=/usr/bin/blocky --config /etc/blocky.yaml ambient=CAP_NET_BIND_SERVICE sandbox=none"
    }
