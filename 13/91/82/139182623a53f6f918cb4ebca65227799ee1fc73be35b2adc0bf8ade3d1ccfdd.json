      "path": "/lib/systemd/system/sshd.service",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=/usr/sbin/sshd -D $SSHD_PARAMETERS sandbox=none"
    },
    {
      "module": "systemd",
      "path": "/lib/systemd/system/sshd.socket",
      "code": "systemd.socket",
      "detail": "scope=system activates=sshd.service"
    },
    {
      "module": "systemd",
      "path": "/lib/systemd/system/sshd@.service",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=-/usr/sbin/sshd -i $SSHD_PARAMETERS sandbox=none"
