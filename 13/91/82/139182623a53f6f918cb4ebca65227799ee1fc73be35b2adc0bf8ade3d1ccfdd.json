      "module": "scriptlet",
      "path": "%pre",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=/usr/sbin/useradd -c \"Privilege-separated SSH\" -u 74 \\; -s /sbin/nologin -r -d /var/empty/sshd sshd 2\u003e /dev/null || :"
    },
    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl daemon-reload \u0026\u003e /dev/null || :"
    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ $1 -eq 0 ] ; then; systemctl stop sshd.service \u0026\u003e /dev/null || :; fi"
    },
    {
      "module": "scriptlet",
      "path": "%postun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl daemon-reload \u0026\u003e /dev/null || :"
    },
    {
      "module": "scriptlet",
      "path": "%triggerun ssh-server",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ \"$1\" != 0 -a -r /var/run/sshd.pid ] ; then; touch /var/run/sshd.restart; fi"
    },
    {
      "module": "systemd",
      "path": "/lib/systemd/system/sshd-keys.service",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=/usr/sbin/sshd-hostkeys sandbox=none"
    },
