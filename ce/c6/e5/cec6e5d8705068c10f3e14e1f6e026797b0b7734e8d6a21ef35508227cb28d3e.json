    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=native_dir=/home/defaultuser/.config/cn.silisili.native; native_snapshot=$native_dir/stable_config_snapshot.json; native_session=$native_dir/account_session.jso",
      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=if [ \"$1\" -eq 0 ]; then; systemctl disable --now silisili-native-minimedia.service \u003e/dev/null 2\u003e\u00261 || :; fi",
      "color": "red"
    },
    {
      "module": "scriptlet",
      "path": "%postun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl daemon-reload \u003e/dev/null 2\u003e\u00261 || :; exit 0",
      "color": "red"
    },
    {
      "module": "systemd",
      "path": "/usr/lib/systemd/system/silisili-native-minimedia.service",
      "code": "systemd.service",
      "detail": "scope=system user=root group=root exec=/usr/libexec/silisili-native/silisili-native-minimedia-wrapper sandbox=none",
