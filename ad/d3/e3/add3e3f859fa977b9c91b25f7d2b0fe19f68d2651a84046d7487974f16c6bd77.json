      "color": "yellow"
    },
    {
      "module": "scriptlet",
      "path": "%pre",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl-user stop org.blacksailer.workshop.sk.service; if /sbin/pidof harbour-SK \u003e /dev/null; then; killall harbour-SK || true",
