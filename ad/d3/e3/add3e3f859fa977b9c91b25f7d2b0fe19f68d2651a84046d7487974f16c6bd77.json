    },
    {
      "module": "scriptlet",
      "path": "%post",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl-user daemon-reload; systemctl-user enable org.blacksailer.workshop.sk; systemctl-user restart org.blacksailer.workshop.sk",
