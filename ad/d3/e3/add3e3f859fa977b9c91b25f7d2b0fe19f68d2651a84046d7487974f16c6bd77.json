    },
    {
      "module": "scriptlet",
      "path": "%preun",
      "code": "scriptlet",
      "detail": "user=root program=/bin/sh body=systemctl-user stop org.blacksailer.workshop.sk.service || true; systemctl-user disable org.blacksailer.workshop.sk || true; systemctl-user daemon-reload",
